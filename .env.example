# Copy to .env (git-ignored) or export in your shell. Used only by `npm run setup`,
# which registers these providers in TrueForge. The extension never reads keys.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional local model behind an OpenAI-compatible endpoint, e.g. http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=

# Optional independent cloud provider; only the free model router is configured.
OPENROUTER_API_KEY=
